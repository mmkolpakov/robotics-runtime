%%{init: {"sequence": {"useMaxWidth": false}}}%%
sequenceDiagram
    actor Integrator
    participant Campaign as Optional campaign system
    participant Supervisor as Finite supervisor
    participant Attempt as Finite attempt owner
    participant Native as Native worker / SDK
    participant Store as Retained evidence
    participant Harness as Contracts / harness
    participant Method as Optional isolated method
    alt Direct CLI / CI
        Integrator->>Attempt: Request one admitted attempt
    else Campaign
        Integrator->>Campaign: Select workload and policy
        Campaign->>Attempt: Request one admitted attempt
    end
    Attempt->>Attempt: Bind identity, profile and resource ownership
    alt Admission fails
        Attempt-->>Integrator: Refused before native effects
    else Admitted
        Attempt->>Native: Start workload and record observations
        alt Startup fails
            Native-->>Attempt: Failure and available observations
            Attempt->>Store: Retain available startup evidence and diagnostics
        else Ready
            Native-->>Attempt: Readiness and native observations
        end
        Attempt->>Native: Close window, capture state and drain if applicable
        alt Producer remains active at deadline
            Attempt->>Supervisor: Bound owned producers, escalate where supported
            Supervisor-->>Attempt: Settled or unknown native outcome
            Attempt->>Store: Preserve closed bytes and durable recovery record
            Attempt-->>Integrator: Incomplete / unknown, explicit recovery required
            Note over Attempt,Store: Do not export until producer settlement is observed
        else Producer settled
            Native-->>Attempt: Settled observations and diagnostics
            Attempt->>Store: Export and verify original bytes
            alt Export fails
                Attempt->>Store: Preserve closed bytes and durable recovery record
                Attempt-->>Integrator: Incomplete, explicit export recovery required
                Note over Attempt,Store: Recovery does not repeat measurement
            else Export is verified
                Attempt->>Native: Dispose owned resources and verify cleanup
                Native-->>Attempt: Cleanup facts or unknown outcome
                Attempt-->>Integrator: Lifecycle report and retained references
                opt Campaign manages the attempt
                    Attempt-->>Campaign: Lifecycle report and retained references
                end
                Integrator->>Harness: Evaluate retained evidence
                Harness->>Store: Validate documents, links and bytes
                opt Custom assessment method
                    Harness->>Method: Verified read-only inputs and method controls
                    Method-->>Harness: Evidence-linked assertions
                end
                Harness-->>Integrator: JSON / JUnit and assessment status
            end
        end
    end
