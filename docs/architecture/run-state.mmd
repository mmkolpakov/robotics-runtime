%%{init: {"state": {"useMaxWidth": false}}}%%
stateDiagram-v2
    direction TB
    state "preloading" as Preloading
    state "ready" as Ready
    state "measuring" as Measuring
    state "Completion callbacks" as Callbacks {
        state "closing-measurement" as Closing
        state "capturing-last-state" as Capturing
        state "draining-recorders" as Draining
        Closing --> Capturing: settled or missing hook
        Capturing --> Draining: settled or missing hook
    }
    state "exporting-evidence" as Exporting
    state "retained" as Retained
    state "disposing" as Disposing
    state "verifying-cleanup" as Verifying
    state "completed" as Completed
    state "error" as Error
    [*] --> Preloading: immutable profile admitted
    Preloading --> Ready: observed readiness and references
    Preloading --> Closing: settled startup failure
    Preloading --> Retained: readiness callback still active
    Ready --> Measuring: beginMeasurement
    Ready --> Closing: finish without measurement
    Measuring --> Closing: finish
    Callbacks --> Retained: deadline with active callback
    Draining --> Exporting: settled or missing hook
    Retained --> Callbacks: explicit recovery at saved cursor
    Retained --> Exporting: callbacks settled, retry export
    Exporting --> Retained: error / active / empty
    Exporting --> Disposing: success + refs
    Disposing --> Verifying: disposal attempted
    Verifying --> Completed: no errors, complete resource proof
    Verifying --> Error: errors or missing proof
    Completed --> [*]
    Error --> [*]
    note right of Retained
        Resources and ID remain reserved.
        Active callbacks block later work.
        Explicit recovery waits for settlement,
        then resumes unattempted stages.
        Previous errors remain recorded.
        finish keeps its cached report.
    end note
    note right of Error
        Release needs DISPOSED and
        attempted/released outcomes
        with retained references.
        No terminal cleanup retry.
        Reservations are process-local.
    end note
