{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test/safe-diagnostics.mjs"
  ]
}
