{
  "manifest_version": "0.3",
  "name": "robotics-runtime-mcp",
  "display_name": "Robotics Runtime offline tools",
  "version": "0.1.0-rc.2",
  "description": "Six read-only tools over explicitly installed robotics contracts and harness CLIs.",
  "author": {
    "name": "Maxim Kolpakov"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmkolpakov/robotics-runtime.git"
  },
  "server": {
    "type": "node",
    "entry_point": "bin/server.mjs",
    "mcp_config": {
      "command": "${user_config.node_executable}",
      "args": [
        "${__dirname}/bin/server.mjs",
        "--config",
        "${user_config.bootstrap_file}"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "linux"
    ],
    "runtimes": {
      "node": "24.21.0"
    }
  },
  "user_config": {
    "node_executable": {
      "type": "file",
      "title": "Node executable",
      "description": "Approved absolute Node 24.21.0 executable path.",
      "required": true
    },
    "bootstrap_file": {
      "type": "file",
      "title": "Operator bootstrap",
      "description": "Absolute path to the prepared offline bootstrap; selects the separately installed C0.21.1/H0.22.3 workers and trusted read corpus.",
      "required": true
    }
  }
}
