    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "forbidden_ros_graph": {
      "$ref": "#/$defs/forbiddenRosGraph"
    },
