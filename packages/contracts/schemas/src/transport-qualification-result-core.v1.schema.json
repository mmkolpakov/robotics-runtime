{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:internal:transport-qualification-result-core",
  "title": "Robotics transport qualification result v1",
  "description": "A domain-neutral result for measured channel delivery and verified W3C Trace Context continuity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "run_id",
    "generated_at",
    "evaluator",
    "trace_evidence",
    "causal_chain_contracts",
    "channel_contracts",
    "channel_observations",
    "causal_chains",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": "transport-qualification-result.v1"
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^qualification-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/runId"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version"
      ],
      "properties": {
        "implementation": {
          "const": "robotics-acceptance-harness"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "maxLength": 64
        }
      }
    },
    "trace_evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/traceEvidence"
      }
    },
    "causal_chain_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/causalChainContract"
      }
    },
    "channel_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/channelContract"
      }
    },
    "channel_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/channelObservation"
      }
    },
    "causal_chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/causalChain"
      }
    },
    "verdict": {
      "$ref": "#/$defs/verdict"
    }
  },
  "$defs": {
    "identifier": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/identifier"
    },
    "sha256": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/sha256"
    },
    "status": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/status"
    },
    "traceEvidence": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/traceEvidence"
    },
    "causalChainContract": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/causalChainContract"
    },
    "channelContract": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/channelContract"
    },
    "channelObservation": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/channelObservation"
    },
    "spanReference": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/spanReference"
    },
    "violation": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/violation"
    },
    "hop": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/hop"
    },
    "causalChain": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/causalChain"
    },
    "verdict": {
      "$ref": "urn:robotics-runtime-contracts:build:transport-qualification-result-core#/$defs/verdict"
    }
  }
}
