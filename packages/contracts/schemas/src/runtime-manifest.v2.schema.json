{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v2:runtime-manifest",
  "title": "Admitted native runtime bindings v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "generated_at",
    "scenario_sha256",
    "execution",
    "profile",
    "evaluator_bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "runtime-manifest.v2"
    },
    "runtime_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scenario_sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
    },
    "execution": {
      "$ref": "urn:robotics-runtime-contracts:v2:internal:native-execution#/$defs/execution"
    },
    "profile": {
      "$ref": "urn:robotics-runtime-contracts:v2:internal:native-execution#/$defs/profile"
    },
    "native_model": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/artifactRef"
    },
    "evaluator_bindings": {
      "$ref": "urn:robotics-runtime-contracts:v1:acceptance-scenario#/properties/evaluator_requirements"
    },
    "execution_subject": {
      "$ref": "urn:robotics-runtime-contracts:v1:runtime-manifest#/properties/execution_subject"
    },
    "authorization": {
      "$ref": "urn:robotics-runtime-contracts:v1:runtime-manifest#/properties/authorization"
    },
    "physical_targets": {
      "$ref": "urn:robotics-runtime-contracts:v1:runtime-manifest#/properties/physical_targets"
    },
    "extension_schemas": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/extensionSchemas"
    },
    "extensions": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "enum": [
                  "hil",
                  "real_robot"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "authorization",
          "physical_targets",
          "execution_subject"
        ]
      }
    }
  ]
}
