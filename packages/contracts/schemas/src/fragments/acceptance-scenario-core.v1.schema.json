{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:build:acceptance-scenario-core",
  "$defs": {
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "permit_schema",
            "verification_schema",
            "trust_policy_sha256",
            "two_party_approval"
          ],
          "properties": {
            "mode": {
              "const": "signed_execution_permit"
            },
            "permit_schema": {
              "const": "execution-permit.v1"
            },
            "verification_schema": {
              "const": "execution-verification.v1"
            },
            "trust_policy_sha256": {
              "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
            },
            "two_party_approval": {
              "const": true
            }
          }
        }
      ]
    },
    "forbiddenRosGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "services",
        "actions"
      ],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
          },
          "uniqueItems": true
        }
      }
    },
    "physicalHilConstraints": {
      "properties": {
        "execution": {
          "properties": {
            "physical_effect": {
              "const": "none"
            },
            "hardware_scope": {
              "minItems": 1,
              "not": {
                "contains": {
                  "const": "actuator"
                }
              }
            },
            "data_source": {
              "const": "live_target"
            },
            "plant_backend": {
              "const": "real_hardware"
            },
            "time_mode": {
              "const": "hardware_realtime"
            },
            "data_plane_profile": {
              "const": "secure_shared_memory"
            },
            "security_profile": {
              "const": "sros2_enforce"
            }
          }
        },
        "authorization": {
          "properties": {
            "mode": {
              "const": "signed_execution_permit"
            }
          }
        }
      }
    },
    "realObservationConstraints": {
      "properties": {
        "execution": {
          "properties": {
            "physical_effect": {
              "const": "observation"
            },
            "hardware_scope": {
              "minItems": 1,
              "not": {
                "contains": {
                  "const": "actuator"
                }
              }
            },
            "data_source": {
              "const": "live_target"
            },
            "plant_backend": {
              "const": "real_hardware"
            },
            "time_mode": {
              "const": "hardware_realtime"
            },
            "data_plane_profile": {
              "const": "secure_shared_memory"
            },
            "security_profile": {
              "const": "sros2_enforce"
            }
          }
        },
        "authorization": {
          "properties": {
            "mode": {
              "const": "signed_execution_permit"
            }
          }
        }
      }
    },
    "identifier": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_environment",
        "hardware_scope",
        "physical_effect",
        "test_intent",
        "data_source",
        "plant_backend",
        "time_mode",
        "data_plane_profile",
        "security_profile"
      ],
      "properties": {
        "target_environment": {
          "enum": [
            "simulation",
            "hil",
            "real_robot"
          ]
        },
        "hardware_scope": {
          "type": "array",
          "items": {
            "enum": [
              "compute",
              "sensor",
              "controller",
              "actuator"
            ]
          },
          "uniqueItems": true
        },
        "physical_effect": {
          "enum": [
            "none",
            "observation",
            "actuation"
          ]
        },
        "test_intent": {
          "enum": [
            "interface_smoke",
            "functional",
            "performance",
            "safety_evidence"
          ]
        },
        "data_source": {
          "enum": [
            "simulator",
            "recording_playback",
            "live_target"
          ]
        },
        "plant_backend": {
          "enum": [
            "interface_mock",
            "simulated_physics",
            "recorded_data",
            "real_hardware"
          ]
        },
        "time_mode": {
          "enum": [
            "simulation_realtime",
            "simulation_stepped",
            "playback_clocked",
            "hardware_realtime"
          ]
        },
        "data_plane_profile": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "security_profile": {
          "enum": [
            "none",
            "sros2_enforce"
          ]
        }
      }
    },
    "sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup_sec",
        "graph_ready_sec",
        "stable_for_sec",
        "execution_sec",
        "shutdown_sec"
      ],
      "properties": {
        "startup_sec": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "graph_ready_sec": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "stable_for_sec": {
          "type": "number",
          "minimum": 0
        },
        "execution_sec": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "shutdown_sec": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        }
      }
    },
    "positiveSeconds": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
    },
    "expectedRosGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "services",
        "actions",
        "lifecycle_nodes"
      ],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-scenario-core#/$defs/topicExpectation"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-scenario-core#/$defs/graphEndpoint"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-scenario-core#/$defs/graphEndpoint"
          }
        },
        "lifecycle_nodes": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-scenario-core#/$defs/lifecycleNode"
          }
        }
      }
    },
    "topicExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "min_publishers",
        "min_subscribers",
        "first_message_timeout_sec"
      ],
      "properties": {
        "name": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
        },
        "type": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosMessageType"
        },
        "min_publishers": {
          "type": "integer",
          "minimum": 0
        },
        "min_subscribers": {
          "type": "integer",
          "minimum": 0
        },
        "first_message_timeout_sec": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "qos_profile": {
          "enum": [
            "system_default",
            "sensor_data",
            "services_default",
            "parameters"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "min_publishers": {
              "minimum": 1
            }
          }
        },
        {
          "properties": {
            "min_subscribers": {
              "minimum": 1
            }
          }
        }
      ]
    },
    "rosName": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
    },
    "graphEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "server_required"
      ],
      "properties": {
        "name": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
        },
        "type": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosType"
        },
        "server_required": {
          "const": true
        }
      }
    },
    "rosType": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosType"
    },
    "lifecycleNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required_state",
        "timeout_sec",
        "stable_for_sec"
      ],
      "properties": {
        "name": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
        },
        "required_state": {
          "const": "active"
        },
        "timeout_sec": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "stable_for_sec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "assertion": {
      "oneOf": [
        {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-scenario-core#/$defs/metricAssertion"
        }
      ]
    },
    "metricAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "kind",
        "metric_name",
        "unit",
        "aggregation",
        "operator",
        "threshold",
        "window_sec",
        "attribute_match"
      ],
      "properties": {
        "assertion_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "kind": {
          "const": "metric"
        },
        "metric_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "aggregation": {
          "enum": [
            "min",
            "max",
            "mean",
            "p50",
            "p95",
            "p99",
            "count"
          ]
        },
        "operator": {
          "enum": [
            "lt",
            "lte",
            "eq",
            "gte",
            "gt"
          ]
        },
        "threshold": {
          "type": "number"
        },
        "window_sec": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "attribute_match": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "timePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_authority_min_samples",
        "max_time_authority_delivery_latency_p50_ms",
        "max_time_authority_delivery_latency_p95_ms",
        "max_time_authority_delivery_latency_ms"
      ],
      "properties": {
        "min_realtime_factor": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "max_deadline_miss_ratio": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/ratio"
        },
        "step_size_sec": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "max_skipped_steps": {
          "type": "integer",
          "minimum": 0
        },
        "playback_rate": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "min_clock_hz": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "message_order": {
          "enum": [
            "received",
            "sent"
          ]
        },
        "qos_overrides_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "clock_sync_protocol": {
          "enum": [
            "ptp",
            "chrony_ntp",
            "mavlink_timesync",
            "micro_xrce_dds",
            "external"
          ]
        },
        "max_clock_offset_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_time_authority_delivery_latency_p50_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_time_authority_delivery_latency_p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_time_authority_delivery_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "time_authority_min_samples": {
          "type": "integer",
          "minimum": 30
        },
        "max_clock_drift_ppm": {
          "type": "number",
          "minimum": 0
        },
        "max_message_age_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ratio": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/ratio"
    },
    "dataPlanePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_message_age_ms",
        "max_loss_ratio",
        "shm_transport",
        "data_sharing",
        "private_ipc"
      ],
      "properties": {
        "max_message_age_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_loss_ratio": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/ratio"
        },
        "shm_transport": {
          "type": "boolean"
        },
        "data_sharing": {
          "type": "boolean"
        },
        "private_ipc": {
          "type": "boolean"
        },
        "middleware_configuration_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        }
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "recording_mode",
        "compression",
        "max_segment_size_bytes",
        "max_segment_duration_sec",
        "max_spool_size_bytes",
        "spool_high_watermark_ratio",
        "max_upload_lag_sec",
        "upload_mode",
        "retention_class",
        "remote_sink_allowed"
      ],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "recording_mode": {
          "enum": [
            "bounded",
            "snapshot",
            "on_failure"
          ]
        },
        "compression": {
          "const": "zstd"
        },
        "max_segment_size_bytes": {
          "type": "integer",
          "minimum": 1048576
        },
        "max_segment_duration_sec": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "max_spool_size_bytes": {
          "type": "integer",
          "minimum": 1048576
        },
        "spool_high_watermark_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_upload_lag_sec": {
          "type": "number",
          "minimum": 0
        },
        "upload_mode": {
          "enum": [
            "local_only",
            "closed_segments_during_run"
          ]
        },
        "retention_class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "remote_sink_allowed": {
          "type": "boolean"
        }
      }
    },
    "extensionSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "schema_uri",
        "sha256"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "schema_uri": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        }
      }
    },
    "extensions": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "interfaceMockConstraints": {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "plant_backend": {
                "const": "interface_mock"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "test_intent": {
                "const": "interface_smoke"
              },
              "physical_effect": {
                "const": "none"
              }
            }
          }
        }
      }
    },
    "simulatorConstraints": {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "data_source": {
                "const": "simulator"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "simulation"
              },
              "plant_backend": {
                "const": "simulated_physics"
              },
              "time_mode": {
                "enum": [
                  "simulation_realtime",
                  "simulation_stepped"
                ]
              }
            }
          }
        }
      }
    },
    "playbackConstraints": {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "data_source": {
                "const": "recording_playback"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "dataset_manifest_sha256"
        ],
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "simulation"
              },
              "plant_backend": {
                "const": "recorded_data"
              },
              "time_mode": {
                "const": "playback_clocked"
              },
              "physical_effect": {
                "const": "none"
              }
            }
          },
          "time_policy": {
            "required": [
              "playback_rate",
              "min_clock_hz",
              "message_order",
              "qos_overrides_sha256"
            ]
          }
        }
      }
    },
    "steppedTimeConstraints": {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "time_mode": {
                "const": "simulation_stepped"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "simulation"
              },
              "test_intent": {
                "enum": [
                  "interface_smoke",
                  "functional"
                ]
              }
            }
          },
          "time_policy": {
            "required": [
              "step_size_sec",
              "max_skipped_steps"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "time_policy": {
            "not": {
              "required": [
                "max_skipped_steps"
              ]
            }
          }
        }
      }
    },
    "simulationRealtimeConstraints": {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "time_mode": {
                "const": "simulation_realtime"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "time_policy": {
            "required": [
              "min_realtime_factor",
              "max_deadline_miss_ratio"
            ]
          }
        }
      }
    },
    "hardwareRealtimeConstraints": {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "time_mode": {
                "const": "hardware_realtime"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "time_policy": {
            "required": [
              "clock_sync_protocol",
              "max_clock_offset_ms",
              "max_clock_drift_ppm",
              "max_message_age_ms"
            ]
          }
        }
      }
    },
    "performanceConstraints": {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "test_intent": {
                "const": "performance"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "time_mode": {
                "enum": [
                  "simulation_realtime",
                  "hardware_realtime"
                ]
              }
            }
          },
          "time_policy": {
            "required": [
              "max_deadline_miss_ratio"
            ]
          }
        }
      }
    },
    "highThroughputConstraints": {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "data_plane_profile": {
                "const": "local_high_throughput"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "security_profile": {
                "const": "none"
              }
            }
          },
          "data_plane_policy": {
            "properties": {
              "shm_transport": {
                "const": true
              },
              "private_ipc": {
                "const": true
              }
            }
          }
        }
      }
