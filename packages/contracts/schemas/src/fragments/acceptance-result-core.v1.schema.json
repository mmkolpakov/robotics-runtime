{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:build:acceptance-result-core",
  "$defs": {
    "timeAuthorityObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "sample_count",
        "window_start_ns",
        "window_end_ns",
        "p50_delivery_latency_ms",
        "p95_delivery_latency_ms",
        "max_delivery_latency_ms",
        "within_policy"
      ],
      "properties": {
        "source_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "window_start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "window_end_ns": {
          "type": "integer",
          "minimum": 0
        },
        "p50_delivery_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "p95_delivery_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_delivery_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "within_policy": {
          "type": "boolean"
        },
        "evidence_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "sample_count"
            ],
            "properties": {
              "sample_count": {
                "minimum": 1
              }
            }
          },
          "then": {
            "required": [
              "evidence_sha256"
            ]
          }
        },
        {
          "if": {
            "required": [
              "within_policy"
            ],
            "properties": {
              "within_policy": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "evidence_sha256"
            ],
            "properties": {
              "sample_count": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "permit_sha256",
            "execution_verification_sha256",
            "trust_policy_sha256",
            "target"
          ],
          "properties": {
            "mode": {
              "const": "verified_execution_permit"
            },
            "permit_sha256": {
              "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
            },
            "execution_verification_sha256": {
              "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
            },
            "trust_policy_sha256": {
              "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
            },
            "target": {
              "$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/target"
            }
          }
        }
      ]
    },
    "forbiddenGraphObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "checked_topics",
        "checked_services",
        "checked_actions",
        "violations"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "checked_topics": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "checked_services": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "checked_actions": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "topic",
                  "service",
                  "action"
                ]
              },
              "name": {
                "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
              }
            }
          }
        }
      }
    },
    "hardwareClockObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sync_protocol",
        "source",
        "measured_at",
        "sample_count",
        "offset_ms",
        "jitter_ms",
        "drift_ppm",
        "max_sample_age_ms",
        "within_policy",
        "evidence_sha256"
      ],
      "properties": {
        "sync_protocol": {
          "enum": [
            "ptp",
            "chrony_ntp",
            "mavlink_timesync",
            "micro_xrce_dds",
            "external"
          ]
        },
        "source": {
          "enum": [
            "pmc",
            "chronyc_tracking",
            "mavlink_timesync_status",
            "controller_telemetry",
            "external_attestation"
          ]
        },
        "measured_at": {
          "type": "string",
          "format": "date-time"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "offset_ms": {
          "type": "number"
        },
        "jitter_ms": {
          "type": "number",
          "minimum": 0
        },
        "drift_ppm": {
          "type": "number"
        },
        "max_sample_age_ms": {
          "type": "number",
          "minimum": 0
        },
        "within_policy": {
          "type": "boolean"
        },
        "evidence_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        }
      }
    },
    "identifier": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
    },
    "assertionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "status",
        "observed_value",
        "unit"
      ],
      "properties": {
        "assertion_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped"
          ]
        },
        "observed_value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "observedRosGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_for_sec",
        "topics",
        "services",
        "actions"
      ],
      "properties": {
        "stable_for_sec": {
          "type": "number",
          "minimum": 0
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/observedTopic"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/observedEndpoint"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/observedEndpoint"
          }
        }
      }
    },
    "observedTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "publishers",
        "subscribers",
        "first_message_at_ns"
      ],
      "properties": {
        "name": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
        },
        "type": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosMessageType"
        },
        "publishers": {
          "type": "integer",
          "minimum": 0
        },
        "subscribers": {
          "type": "integer",
          "minimum": 0
        },
        "first_message_at_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rosName": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
    },
    "observedEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "servers"
      ],
      "properties": {
        "name": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*/(?:srv|action)/[A-Za-z][A-Za-z0-9_]*$"
        },
        "servers": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_environment",
        "data_source",
        "plant_backend",
        "time_mode",
        "data_plane_profile"
      ],
      "properties": {
        "target_environment": {
          "enum": [
            "simulation",
            "hil",
            "real_robot"
          ]
        },
        "data_source": {
          "enum": [
            "simulator",
            "recording_playback",
            "live_target"
          ]
        },
        "plant_backend": {
          "enum": [
            "interface_mock",
            "simulated_physics",
            "recorded_data",
            "real_hardware"
          ]
        },
        "time_mode": {
          "enum": [
            "simulation_realtime",
            "simulation_stepped",
            "playback_clocked",
            "hardware_realtime"
          ]
        },
        "data_plane_profile": {
          "enum": [
            "standard_isolated",
            "local_high_throughput",
            "secure_shared_memory"
          ]
        }
      }
    },
    "workload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "runtime_family",
            "actual_provider",
            "model_format",
            "fallback_count"
          ],
          "properties": {
            "kind": {
              "const": "inference"
            },
            "runtime_family": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "actual_provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "model_format": {
              "enum": [
                "onnx",
                "tensorrt_engine",
                "rknn"
              ]
            },
            "fallback_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "lifecycleState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "state",
        "observed_at_ns"
      ],
      "properties": {
        "node": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
        },
        "state": {
          "enum": [
            "unknown",
            "unconfigured",
            "inactive",
            "active",
            "finalized"
          ]
        },
        "observed_at_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "clockObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monotonic",
        "offset_ms",
        "drift_ppm",
        "real_time_factor",
        "deadline_miss_ratio"
      ],
      "properties": {
        "monotonic": {
          "type": "boolean"
        },
        "offset_ms": {
          "type": "number"
        },
        "drift_ppm": {
          "type": "number"
        },
        "real_time_factor": {
          "type": "number",
          "minimum": 0
        },
        "deadline_miss_ratio": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/ratio"
        }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observer_detached",
        "recorders_closed",
        "evidence_index_finalized"
      ],
      "properties": {
        "observer_detached": {
          "type": "boolean"
        },
        "recorders_closed": {
          "type": "boolean"
        },
        "evidence_index_finalized": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "media_type",
        "sha256",
        "size_bytes",
        "retention_class"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "immutable_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255
        },
        "sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "retention_class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "extensions": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "target_id",
        "identity_kind",
        "identity_sha256"
      ],
      "properties": {
        "environment": {
          "enum": [
            "hil",
            "real_robot"
          ]
        },
        "target_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "identity_kind": {
          "enum": [
            "udev_serial",
            "pci_device",
            "mavlink_system_component",
            "x509_spki",
            "tpm_ek",
            "vendor_soc"
          ]
        },
        "identity_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        }
      }
    },
    "passedEvidenceConstraints": {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "assertion_results": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1
          },
          "time_authority_observation": {
            "required": [
              "evidence_sha256"
            ],
            "properties": {
              "sample_count": {
                "minimum": 1
              }
            }
          },
          "unevaluated": {
            "maxItems": 0
          }
        }
      }
    },
    "incompleteConstraints": {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "incomplete"
          }
        }
      },
      "then": {
        "properties": {
          "unevaluated": {
            "minItems": 1
          }
        }
      }
    },
    "passedAssertionsConstraints": {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "assertion_results": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          },
          "forbidden_graph_observation": {
            "properties": {
              "passed": {
                "const": true
              },
              "violations": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    "simulationConstraints": {
      "if": {
        "required": [
          "execution"
        ],
        "properties": {
          "execution": {
            "required": [
              "target_environment"
            ],
            "properties": {
              "target_environment": {
                "const": "simulation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "authorization": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          }
        },
        "not": {
          "required": [
            "hardware_clock_observation"
          ]
        }
      }
    },
    "physicalConstraints": {
      "if": {
        "required": [
          "execution"
        ],
        "properties": {
          "execution": {
            "required": [
              "target_environment"
            ],
            "properties": {
              "target_environment": {
                "enum": [
                  "hil",
                  "real_robot"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "hardware_clock_observation"
        ],
        "properties": {
          "authorization": {
            "properties": {
              "mode": {
                "const": "verified_execution_permit"
              }
            }
          },
          "execution": {
            "properties": {
              "data_source": {
                "const": "live_target"
              },
              "plant_backend": {
                "const": "real_hardware"
              },
              "time_mode": {
                "const": "hardware_realtime"
              },
              "data_plane_profile": {
                "const": "secure_shared_memory"
              }
            }
          }
        }
      }
    },
    "inferenceConstraints": {
      "if": {
        "required": [
          "workload"
        ],
        "properties": {
          "workload": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "inference"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "model_manifest_sha256"
        ]
      }
    }
  }
}
