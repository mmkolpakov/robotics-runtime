{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:build:transport-qualification-result-core",
  "$defs": {
    "identifier": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "incomplete",
        "error"
      ]
    },
    "traceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "evidence_index_sha256",
        "artifact_id",
        "uri",
        "media_type",
        "format",
        "signal",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "domain_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "evidence_index_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "artifact_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "media_type": {
          "const": "application/x-ndjson"
        },
        "format": {
          "const": "otlp-jsonl"
        },
        "signal": {
          "const": "traces"
        },
        "sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "causalChainContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "sha256"
      ],
      "properties": {
        "chain_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        }
      }
    },
    "channelContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "source_domain_id",
        "destination_domain_id",
        "sha256"
      ],
      "properties": {
        "channel_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "source_domain_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "destination_domain_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        }
      }
    },
    "channelObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "observation_id",
        "sha256",
        "status"
      ],
      "properties": {
        "channel_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^observation-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "status": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:transport-qualification-result-core#/$defs/status"
        }
      }
    },
    "spanReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "trace_id",
        "span_id",
        "message_id"
      ],
      "properties": {
        "domain_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        },
        "message_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/spanName"
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "missing_trace_evidence",
            "missing_span",
            "trace_id_mismatch",
            "relationship_mismatch",
            "temporal_order_mismatch",
            "message_id_mismatch",
            "channel_observation_failed",
            "evaluation_error"
          ]
        },
        "channel_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "hop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "relationship",
        "producer",
        "consumer",
        "status",
        "violations"
      ],
      "properties": {
        "channel_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "relationship": {
          "enum": [
            "link",
            "parent"
          ]
        },
        "producer": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:transport-qualification-result-core#/$defs/spanReference"
        },
        "consumer": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:transport-qualification-result-core#/$defs/spanReference"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:transport-qualification-result-core#/$defs/violation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "violations": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "violations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "causalChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "expected_contract_sha256",
        "channel_ids",
        "status",
        "hops",
        "violations"
      ],
      "properties": {
        "chain_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "expected_contract_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "root_trace_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "trace_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "channel_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
          }
        },
        "status": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:transport-qualification-result-core#/$defs/status"
        },
        "hops": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:transport-qualification-result-core#/$defs/hop"
          }
        },
        "violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:transport-qualification-result-core#/$defs/violation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "root_trace_id",
              "trace_ids"
            ],
            "properties": {
              "hops": {
                "minItems": 1
              },
              "violations": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "violations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evaluated_at",
        "chain_count",
        "passed_chain_count",
        "failed_chain_count",
        "incomplete_chain_count",
        "error_chain_count"
      ],
      "properties": {
        "status": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:transport-qualification-result-core#/$defs/status"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "chain_count": {
          "type": "integer",
          "minimum": 1
        },
        "passed_chain_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_chain_count": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete_chain_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_chain_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
