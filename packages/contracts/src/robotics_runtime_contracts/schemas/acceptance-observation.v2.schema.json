{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v2:acceptance-observation",
  "title": "Captured native acceptance observations v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "run_id",
    "scenario_id",
    "domain_id",
    "scenario_sha256",
    "runtime_manifest_sha256",
    "started_at",
    "finished_at",
    "observations",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "acceptance-observation.v2"
    },
    "observation_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "run_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/runId"
    },
    "scenario_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "domain_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "scenario_sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
    },
    "runtime_manifest_sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "observations": {
      "$ref": "urn:robotics-runtime-contracts:v2:internal:native-execution#/$defs/observations"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/artifactRef"
      }
    },
    "extension_schemas": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/extensionSchemas"
    },
    "extensions": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/extensions"
    },
    "native_model": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/artifactRef"
    }
  }
}
