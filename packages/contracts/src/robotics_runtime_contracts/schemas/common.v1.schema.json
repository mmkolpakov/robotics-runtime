{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:internal:common",
  "title": "Robotics runtime common definitions v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subjectDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "passed",
        "skipped",
        "cancelled",
        "incomplete",
        "failed",
        "error"
      ]
    },
    "qualificationArtifactKind": {
      "enum": [
        "scenario",
        "acceptance_observation",
        "runtime_manifest",
        "acceptance_run",
        "domain_result",
        "acceptance_aggregate",
        "transport_qualification",
        "evidence_index",
        "recording_summary",
        "metrics",
        "traces",
        "junit",
        "causal_chain_contract",
        "channel_contract",
        "channel_observation",
        "clock_relation",
        "provider_conformance",
        "artifact_receipt",
        "artifact_verification",
        "qualification_profile",
        "model_manifest",
        "dataset_manifest",
        "execution_permit",
        "execution_verification",
        "policy",
        "package",
        "attestation",
        "verification",
        "recording",
        "other_evidence"
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255
        },
        "immutable_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "sceneObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_scene_id",
        "entities",
        "interfaces",
        "physical_parameters"
      ],
      "properties": {
        "semantic_scene_id": {
          "$ref": "#/$defs/identifier"
        },
        "entities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "interfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "physical_parameters": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "integer",
              "string",
              "boolean"
            ]
          }
        }
      }
    },
    "providerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "implementation_id",
        "version",
        "configuration_sha256"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "implementation_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "rosName": {
      "type": "string",
      "pattern": "^/[^\\s]+$"
    },
    "runSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rosType": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*/(?:msg|srv|action)/[A-Za-z][A-Za-z0-9_]*$"
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "metricName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 255
    },
    "parameterValue": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "rosMessageType": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*/msg/[A-Za-z][A-Za-z0-9_]*$"
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}$",
      "maxLength": 255
    },
    "principal": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/-]{2,255}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "providerName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
      "maxLength": 128
    },
    "transportRosName": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9_~/]+$",
      "maxLength": 512
    },
    "transportRosMessageType": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*/msg/[A-Za-z][A-Za-z0-9_]*$",
      "maxLength": 256
    },
    "spanName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "extensionSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "schema_uri",
        "sha256"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "schema_uri": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        }
      }
    },
    "extensions": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "extensionSchemas": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/extensionSchema"
      }
    }
  }
}
