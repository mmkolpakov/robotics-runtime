{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:acceptance-run",
  "title": "Acceptance run context",
  "description": "Immutable context created before an acceptance execution starts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "scenario_id",
    "scenario_sha256",
    "time_authority",
    "domains"
  ],
  "properties": {
    "schema_version": {
      "const": "acceptance-run.v1"
    },
    "run_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/runId"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scenario_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "scenario_sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/runSha256"
    },
    "time_authority": {
      "$ref": "#/$defs/timeAuthority"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "extension_schemas": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/extensionSchemas"
    },
    "extensions": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/extensions"
    }
  },
  "$defs": {
    "identifier": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "runId": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/runId"
    },
    "sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/runSha256"
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "role"
      ],
      "properties": {
        "domain_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "role": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        }
      }
    },
    "timeAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sim_clock",
            "playback_clock",
            "ptp",
            "chrony_ntp",
            "mavlink_timesync",
            "external"
          ]
        },
        "source_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "configuration_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/runSha256"
        }
      }
    }
  }
}
