{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:qualification-bundle",
  "title": "Robotics qualification bundle v1",
  "description": "An in-toto Statement that names every artifact in one qualification run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "predicateType": {
      "const": "https://robotics-runtime-contracts.dev/attestations/qualification-bundle/v1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "generated_at",
        "artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": "qualification-bundle.v1"
        },
        "run_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/runId"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifacts": {
          "type": "array",
          "minItems": 7,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "extension_schemas": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/extensionSchemas"
        },
        "extensions": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/extensions"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject_name"
      ],
      "properties": {
        "kind": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/qualificationArtifactKind"
        },
        "subject_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
