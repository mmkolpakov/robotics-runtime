{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:transport-channel",
  "title": "Robotics transport channel contract v1",
  "description": "A traceable ROS 2 channel routed between isolated communication domains.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel_id",
    "source",
    "destination",
    "implementation_binding",
    "qos",
    "delivery",
    "trace"
  ],
  "properties": {
    "schema_version": {
      "const": "transport-channel.v1"
    },
    "channel_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "source": {
      "$ref": "#/$defs/endpoint"
    },
    "destination": {
      "$ref": "#/$defs/endpoint"
    },
    "implementation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_id",
        "version",
        "configuration_sha256"
      ],
      "properties": {
        "implementation_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "maxLength": 64
        },
        "configuration_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "qos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reliability",
        "durability",
        "history",
        "liveliness",
        "liveliness_lease_duration_ms",
        "deadline_ms",
        "lifespan_ms"
      ],
      "properties": {
        "reliability": {
          "enum": [
            "reliable",
            "best_effort"
          ]
        },
        "durability": {
          "enum": [
            "volatile",
            "transient_local"
          ]
        },
        "history": {
          "enum": [
            "keep_last",
            "keep_all"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        },
        "liveliness": {
          "enum": [
            "automatic",
            "manual_by_topic"
          ]
        },
        "liveliness_lease_duration_ms": {
          "$ref": "#/$defs/duration"
        },
        "deadline_ms": {
          "$ref": "#/$defs/duration"
        },
        "lifespan_ms": {
          "$ref": "#/$defs/duration"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "history": {
                "const": "keep_last"
              }
            },
            "required": [
              "history"
            ]
          },
          "then": {
            "required": [
              "depth"
            ]
          },
          "else": {
            "not": {
              "required": [
                "depth"
              ]
            }
          }
        }
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_window_sec",
        "minimum_source_messages",
        "message_id_attribute",
        "max_loss_ratio",
        "max_duplicate_count",
        "max_out_of_order_count",
        "max_message_age_ms"
      ],
      "properties": {
        "observation_window_sec": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/positiveSeconds"
        },
        "minimum_source_messages": {
          "type": "integer",
          "minimum": 1
        },
        "message_id_attribute": {
          "const": "messaging.message.id"
        },
        "max_loss_ratio": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/ratio"
        },
        "max_duplicate_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_out_of_order_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_message_age_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier_field",
        "relationship",
        "producer_span_name",
        "consumer_span_name"
      ],
      "properties": {
        "carrier_field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
          "maxLength": 128
        },
        "relationship": {
          "enum": [
            "link",
            "parent"
          ]
        },
        "producer_span_name": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/spanName"
        },
        "consumer_span_name": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/spanName"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "ros_domain_id",
        "topic",
        "message_type",
        "type_hash"
      ],
      "properties": {
        "domain_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "ros_domain_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 232
        },
        "topic": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/transportRosName"
        },
        "message_type": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/transportRosMessageType"
        },
        "type_hash": {
          "type": "string",
          "pattern": "^RIHS01_[a-f0-9]{64}$"
        }
      }
    },
    "duration": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "const": "infinite"
        }
      ]
    },
    "rosName": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/transportRosName"
    },
    "rosType": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/transportRosMessageType"
    },
    "spanName": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/spanName"
    }
  }
}
