{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:evidence-index",
  "title": "Robotics evidence index v1",
  "description": "Provider-neutral finalized index of retained acceptance evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "finalized",
    "policy_observation",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "evidence-index.v1"
    },
    "run_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/runId"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "finalized": {
      "const": true
    },
    "policy_observation": {
      "$ref": "#/$defs/policyObservation"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "extension_schemas": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/extensionSchemas"
    }
  },
  "$defs": {
    "runId": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/runId"
    },
    "sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
    },
    "mediaType": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/mediaType"
    },
    "policyObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recording_mode",
        "compression",
        "retention_class",
        "upload_mode",
        "remote_sink_used",
        "spool_peak_size_bytes",
        "upload_lag_max_sec"
      ],
      "properties": {
        "recording_mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "compression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retention_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "upload_mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "remote_sink_used": {
          "type": "boolean"
        },
        "spool_peak_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "upload_lag_max_sec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "uri",
        "media_type",
        "sha256",
        "size_bytes",
        "retention_class",
        "storage_state"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "kind": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "local_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "media_type": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/mediaType"
        },
        "sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "retention_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "storage_state": {
          "enum": [
            "local",
            "retained"
          ]
        },
        "immutable_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "receipt_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0
        },
        "recording_summary": {
          "$ref": "#/$defs/summaryReference"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "storage_state": {
                "const": "local"
              }
            },
            "required": [
              "storage_state"
            ]
          },
          "then": {
            "required": [
              "local_path"
            ],
            "properties": {
              "uri": {
                "pattern": "^file:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "storage_state": {
                "const": "retained"
              }
            },
            "required": [
              "storage_state"
            ]
          },
          "then": {
            "required": [
              "immutable_revision",
              "receipt_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "recording"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "recording_summary"
            ]
          }
        }
      ]
    },
    "summaryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
