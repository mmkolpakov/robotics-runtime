{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:internal:runtime-manifest-core",
  "title": "Robotics runtime manifest v1",
  "description": "Observed runtime identity with cryptographically authorized physical target facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "generated_at",
    "execution_subject",
    "components",
    "host_platform",
    "execution_platform",
    "ros",
    "provider_bindings",
    "render",
    "workload",
    "execution",
    "authorization",
    "data_plane",
    "security",
    "lifecycle_states",
    "physical_targets",
    "clock"
  ],
  "properties": {
    "schema_version": {
      "const": "runtime-manifest.v1"
    },
    "runtime_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_subject": {
      "$ref": "#/$defs/executionSubject"
    },
    "components": {
      "$ref": "#/$defs/components"
    },
    "configuration_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configurationArtifact"
      },
      "uniqueItems": true
    },
    "host_platform": {
      "$ref": "#/$defs/platform"
    },
    "execution_platform": {
      "$ref": "#/$defs/platform"
    },
    "ros": {
      "$ref": "#/$defs/ros"
    },
    "provider_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/providerBinding"
      },
      "uniqueItems": true
    },
    "render": {
      "$ref": "#/$defs/render"
    },
    "workload": {
      "$ref": "#/$defs/workload"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "data_plane": {
      "$ref": "#/$defs/dataPlane"
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "lifecycle_states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycleState"
      }
    },
    "physical_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/physicalTarget"
      }
    },
    "clock": {
      "$ref": "#/$defs/clock"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/simulationConstraints"
    },
    {
      "$ref": "#/$defs/physicalConstraints"
    }
  ],
  "$defs": {
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "permit_sha256",
            "execution_verification_sha256",
            "trust_policy_sha256"
          ],
          "properties": {
            "mode": {
              "const": "verified_execution_permit"
            },
            "permit_sha256": {
              "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
            },
            "execution_verification_sha256": {
              "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
            },
            "trust_policy_sha256": {
              "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
            }
          }
        }
      ]
    },
    "physicalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "scope",
        "identity_kind",
        "identity_sha256",
        "preflight_evidence_sha256"
      ],
      "properties": {
        "target_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "scope": {
          "enum": [
            "compute",
            "sensor",
            "controller"
          ]
        },
        "identity_kind": {
          "enum": [
            "udev_serial",
            "pci_device",
            "mavlink_system_component",
            "x509_spki",
            "tpm_ek",
            "vendor_soc"
          ]
        },
        "identity_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "preflight_evidence_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "stable_device_path": {
          "type": "string",
          "pattern": "^/dev/[^*?\\s]+$"
        }
      }
    },
    "providerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "provider",
        "qualification_profile_sha256",
        "conformance_result_sha256",
        "capabilities"
      ],
      "properties": {
        "target_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "provider": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/providerIdentity"
        },
        "qualification_profile_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "conformance_result_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
          }
        },
        "scene": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sceneObservation"
        }
      }
    },
    "configurationArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "inference_provider",
            "host_topology",
            "runtime_resources"
          ]
        },
        "sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        }
      }
    },
    "identifier": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
    },
    "executionSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "oci_image",
            "native_process",
            "firmware",
            "virtual_machine"
          ]
        },
        "locator": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "digest": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/subjectDigest"
        },
        "provenance_receipt_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts_revision",
        "harness_revision",
        "infra_revision"
      ],
      "properties": {
        "contracts_revision": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/gitRevision"
        },
        "harness_revision": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/gitRevision"
        },
        "infra_revision": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/gitRevision"
        }
      }
    },
    "gitRevision": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/gitRevision"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "os_version",
        "architecture",
        "kernel"
      ],
      "properties": {
        "os": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "os_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "architecture": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "maxLength": 64
        },
        "kernel": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/spanName"
        }
      }
    },
    "ros": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "rmw_implementation",
        "rmw_version",
        "domain_id"
      ],
      "properties": {
        "distribution": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 64
        },
        "rmw_implementation": {
          "type": "string",
          "pattern": "^rmw_[a-z0-9_]+$",
          "maxLength": 128
        },
        "rmw_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "domain_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 232
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "renderer"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "software",
            "hardware"
          ]
        },
        "renderer": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/spanName"
        }
      }
    },
    "workload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            },
            "robot_description": {
              "$ref": "#/$defs/robotDescriptionBinding"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "model",
            "inference",
            "accelerator"
          ],
          "properties": {
            "kind": {
              "const": "inference"
            },
            "robot_description": {
              "$ref": "#/$defs/robotDescriptionBinding"
            },
            "model": {
              "$ref": "#/$defs/model"
            },
            "inference": {
              "$ref": "#/$defs/inference"
            },
            "accelerator": {
              "$ref": "#/$defs/accelerator"
            }
          }
        }
      ]
    },
    "robotDescriptionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "description": "SHA-256 of the exact retained robot-description document bytes.",
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "artifact_sha256",
        "format"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "artifact_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "format": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        }
      }
    },
    "sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_family",
        "runtime_version",
        "requested_provider",
        "actual_provider",
        "fallback_count"
      ],
      "properties": {
        "runtime_family": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requested_provider": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/providerName"
        },
        "actual_provider": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/providerName"
        },
        "fallback_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provider": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/providerName"
    },
    "accelerator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "device_class",
        "device_id"
      ],
      "properties": {
        "vendor": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "device_class": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        },
        "device_id": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/spanName"
        },
        "driver_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "software_components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_id",
              "version"
            ],
            "properties": {
              "component_id": {
                "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_environment",
        "data_source",
        "plant_backend",
        "time_mode",
        "data_plane_profile"
      ],
      "properties": {
        "target_environment": {
          "enum": [
            "simulation",
            "hil",
            "real_robot"
          ]
        },
        "data_source": {
          "enum": [
            "simulator",
            "recording_playback",
            "live_target"
          ]
        },
        "plant_backend": {
          "enum": [
            "interface_mock",
            "simulated_physics",
            "recorded_data",
            "real_hardware"
          ]
        },
        "time_mode": {
          "enum": [
            "simulation_realtime",
            "simulation_stepped",
            "playback_clocked",
            "hardware_realtime"
          ]
        },
        "data_plane_profile": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
        }
      }
    },
    "dataPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rmw_implementation",
        "ipc_namespace",
        "network_namespace",
        "shm_transport",
        "data_sharing",
        "private_ipc"
      ],
      "properties": {
        "rmw_implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "middleware_configuration_sha256": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
        },
        "ipc_namespace": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/spanName"
        },
        "network_namespace": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/spanName"
        },
        "shm_transport": {
          "type": "boolean"
        },
        "data_sharing": {
          "type": "boolean"
        },
        "private_ipc": {
          "type": "boolean"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "strategy",
        "enclaves",
        "policy_digests"
      ],
      "properties": {
        "profile": {
          "enum": [
            "none",
            "sros2_enforce"
          ]
        },
        "strategy": {
          "enum": [
            "none",
            "Enforce"
          ]
        },
        "enclaves": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "policy_digests": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
          },
          "uniqueItems": true
        }
      }
    },
    "lifecycleState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "state",
        "observed_at_ns"
      ],
      "properties": {
        "node": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/rosName"
        },
        "state": {
          "enum": [
            "unknown",
            "unconfigured",
            "inactive",
            "active",
            "finalized"
          ]
        },
        "observed_at_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "sync_protocol",
        "offset_ms",
        "drift_ppm"
      ],
      "properties": {
        "basis": {
          "enum": [
            "ros_time",
            "system_time",
            "ptp_time"
          ]
        },
        "sync_protocol": {
          "enum": [
            "sim_clock",
            "playback_clock",
            "ptp",
            "chrony_ntp",
            "mavlink_timesync",
            "micro_xrce_dds",
            "external"
          ]
        },
        "offset_ms": {
          "type": "number"
        },
        "drift_ppm": {
          "type": "number"
        }
      }
    },
    "extensions": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "simulationConstraints": {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "simulation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "authorization": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          },
          "physical_targets": {
            "maxItems": 0
          }
        }
      }
    },
    "physicalConstraints": {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "enum": [
                  "hil",
                  "real_robot"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "authorization": {
            "properties": {
              "mode": {
                "const": "verified_execution_permit"
              }
            }
          },
          "security": {
            "properties": {
              "profile": {
                "const": "sros2_enforce"
              },
              "strategy": {
                "const": "Enforce"
              }
            }
          },
          "execution": {
            "properties": {
              "time_mode": {
                "const": "hardware_realtime"
              },
              "data_source": {
                "const": "live_target"
              },
              "plant_backend": {
                "const": "real_hardware"
              }
            }
          },
          "physical_targets": {
            "minItems": 1
          }
        }
      }
    }
  }
}
