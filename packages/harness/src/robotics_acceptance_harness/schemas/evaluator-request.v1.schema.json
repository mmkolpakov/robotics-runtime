{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finite evaluator request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "domain_id",
    "namespace",
    "expected_assertion_ids",
    "method",
    "documents",
    "controls",
    "evidence",
    "locations"
  ],
  "properties": {
    "schema_version": {
      "const": "evaluator-request.v1"
    },
    "run_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:acceptance-result#/properties/run_id"
    },
    "domain_id": {
      "$ref": "urn:robotics-runtime-contracts:v1:acceptance-result#/properties/domain_id"
    },
    "namespace": {
      "$ref": "urn:robotics-runtime-contracts:v1:acceptance-result#/$defs/assertionResult/properties/namespace",
      "maxLength": 128
    },
    "expected_assertion_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"
      }
    },
    "method": {
      "$ref": "urn:robotics-runtime-contracts:v2:internal:native-execution#/$defs/evaluationMethod"
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_scenario",
        "runtime_manifest",
        "acceptance_run",
        "acceptance_observation",
        "evidence_index"
      ],
      "properties": {
        "acceptance_scenario": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/artifactRef"
        },
        "runtime_manifest": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/artifactRef"
        },
        "acceptance_run": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/artifactRef"
        },
        "acceptance_observation": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/artifactRef"
        },
        "evidence_index": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/artifactRef"
        },
        "acceptance_result": {
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/artifactRef"
        }
      }
    },
    "controls": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/artifactRef"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "urn:robotics-runtime-contracts:v1:acceptance-result#/properties/evidence/items"
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "path"
        ],
        "properties": {
          "sha256": {
            "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "window": {
      "$ref": "urn:robotics-runtime-contracts:v2:internal:native-execution#/$defs/measurementWindow"
    }
  }
}
