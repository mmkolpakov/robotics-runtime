{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "pep621",
    "pre-commit",
    "npm",
    "custom.regex"
  ],
  "pre-commit": {
    "enabled": true
  },
  "timezone": "Europe/Helsinki",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchPackageNames": [
        "ruff",
        "astral-sh/ruff-pre-commit"
      ],
      "groupName": "Ruff package and hooks"
    },
    {
      "matchPackageNames": [
        "check-jsonschema",
        "python-jsonschema/check-jsonschema"
      ],
      "groupName": "check-jsonschema package and hooks"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "non-major dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "cordis",
        "@cordisjs/plugin-loader",
        "@cordisjs/plugin-include"
      ],
      "groupName": "Cordis host cohort",
      "rangeStrategy": "pin"
    },
    {
      "description": "Review hosted runner platform migrations separately from dependency updates",
      "matchDatasources": [
        "github-runners"
      ],
      "dependencyDashboardApproval": true,
      "groupName": "GitHub runner migrations",
      "automerge": false,
      "prBodyNotes": [
        "Qualify the changed hosted runner platform and its release/consumer paths before approving this migration in the Dependency Dashboard. Container image compatibility is reviewed separately."
      ]
    },
    {
      "description": "Review Node and npm toolchain declarations as one compatibility cohort",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines",
        "packageManager"
      ],
      "matchPackageNames": [
        "node",
        "npm"
      ],
      "groupName": "Node and npm toolchain",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "prBodyNotes": [
        "Coordinate Node and npm with the supported host release and its published consumer requirements before approving this update."
      ]
    },
    {
      "description": "Review Node runtime images with the Node and npm toolchain",
      "matchManagers": [
        "dockerfile",
        "github-actions"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "groupName": "Node and npm toolchain",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "prBodyNotes": [
        "Coordinate Node and npm with the supported host release and its published consumer requirements before approving this update."
      ]
    },
    {
      "description": "Keep Node type declarations within the supported Node major",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@types/node"
      ],
      "allowedVersions": ">=24 <25"
    },
    {
      "description": "Review supported Python versions as a release compatibility change",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "requires-python"
      ],
      "matchPackageNames": [
        "python"
      ],
      "enabled": false
    }
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "description": "host, api and mcp share one root package-lock.json in the npm workspace.",
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ]
  },
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track hosted runner labels in explicit CI executor selections",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "fromJSON\\('\\{\"hosted\":\"(?<depName>ubuntu)-(?<currentValue>\\d{2}\\.\\d{2}(?:-arm)?)\""
      ],
      "datasourceTemplate": "github-runners",
      "depTypeTemplate": "github-runner",
      "versioningTemplate": "docker"
    }
  ]
}
